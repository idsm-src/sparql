<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>cz.iocb.sparql</groupId>
  <artifactId>sparql</artifactId>
  <version>0.9.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>sparql engine</name>

  <modules>
  	<module>engine</module>
  	<module>endpoint</module>
  	<module>ryu</module>
  </modules>

  <properties>
    <maven.version.ignore>(?i).*-(alpha|beta|rc|b|m)([-.]?[0-9.]+)?</maven.version.ignore>
    <project.build.sourceEncoding>utf-8</project.build.sourceEncoding>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.12.0</version>
          <configuration>
            <!-- equivalent of "javadoc -private -Xdoclint:all"; any warning fails the build -->
            <show>private</show>
            <doclint>all</doclint>
            <failOnWarnings>true</failOnWarnings>
            <quiet>true</quiet>
            <!-- sources generated by ANTLR are not documented -->
            <excludePackageNames>cz.iocb.sparql.engine.grammar</excludePackageNames>
          </configuration>
          <executions>
            <execution>
              <id>javadoc</id>
              <phase>package</phase>
              <goals>
                <goal>javadoc</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
